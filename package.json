{
  "name": "termlume",
  "version": "0.1.0-alpha.3",
  "private": true,
  "description": "SSH, SFTP, Telnet and WSL terminal for Windows",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "npm run build:native && electron-vite dev",
    "build": "npm run build:native && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "check:native": "node scripts/check-native.cjs",
    "dist:win": "node scripts/release-win.cjs",
    "test:package": "node scripts/package-smoke.cjs",
    "format": "prettier --write src tests scripts electron.vite.config.ts vitest.config.mts playwright.config.ts tsconfig*.json",
    "build:native": "node scripts/build-native-drag.cjs"
  },
  "dependencies": {
    "@catppuccin/palette": "1.8.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "basic-ftp": "^6.2.3",
    "electron-updater": "6.8.9",
    "iconv-lite": "0.7.3",
    "lucide-react": "1.59.0",
    "node-pty": "1.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ssh2": "1.17.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ssh2": "1.15.6",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "author": "Termlume",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Termlume/Termlume.git"
  },
  "homepage": "https://github.com/Termlume/Termlume",
  "bugs": {
    "url": "https://github.com/Termlume/Termlume/issues"
  }
}
